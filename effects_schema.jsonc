[
  // ── time (not persisted, set at runtime) ──
  {"field": "g_time",              "type": "float"},

  // ── hue ──
  {"field": "g_hue_amount",       "type": "float", "cfg": ["hue","amount"],          "def": 0.0,    "ui_edit": "hue"},
  {"field": "g_hue_speed",        "type": "float", "cfg": ["hue","speed"],           "def": 0.08,   "ui_edit": "hue"},
  {"field": "g_hue_min_speed",    "type": "float", "cfg": ["hue","min_speed"],       "def": 0.0,    "ui_edit": "hue_minspeed"},
  {"field": "g_hue_max_speed",    "type": "float", "cfg": ["hue","max_speed"],       "def": 2.0,    "ui_edit": "hue_maxspeed"},
  {"field": "g_hue_mod_speed",    "type": "float", "cfg": ["hue","mod_speed"],       "def": 1.0,    "ui_edit": "hue_modspeed"},
  {"field": "g_hue_enabled",      "type": "int",   "cfg": ["hue","enabled"],         "def": false,  "is_bool": true,  "ui_check": "hue"},
  {"field": "g_hue_r_enabled",    "type": "int",   "cfg": ["hue","r_enabled"],       "def": true,   "is_bool": true,  "ui_check": "hue_r"},
  {"field": "g_hue_g_enabled",    "type": "int",   "cfg": ["hue","g_enabled"],       "def": true,   "is_bool": true,  "ui_check": "hue_g"},
  {"field": "g_hue_b_enabled",    "type": "int",   "cfg": ["hue","b_enabled"],       "def": true,   "is_bool": true,  "ui_check": "hue_b"},
  {"field": "g_hue_mod_enabled",  "type": "int",   "cfg": ["hue","mod_enabled"],     "def": false,  "is_bool": true,  "ui_check": "hue_mod"},

  // ── contrast / saturation ──
  // cfg_field differs from g_ name (amount suffix)
  {"field": "g_contrast",         "type": "float", "cfg": ["contrast","amount"],     "def": 1.0,     "cfg_field": "contrast_amount",   "ui_edit": "contrast"},
  {"field": "g_saturation",       "type": "float", "cfg": ["saturation","amount"],   "def": 1.0,     "cfg_field": "saturation_amount", "ui_edit": "saturation"},
  {"field": "g_contrast_enabled",   "type": "int", "cfg": ["contrast","enabled"],    "def": false,   "is_bool": true,  "ui_check": "contrast"},
  {"field": "g_saturation_enabled", "type": "int", "cfg": ["saturation","enabled"],  "def": false,   "is_bool": true,  "ui_check": "saturation"},

  // ── invert / grayscale ──
  {"field": "g_invert_enabled",    "type": "int",  "cfg": ["invert","enabled"],       "def": false,  "is_bool": true,  "ui_check": "invert"},
  {"field": "g_grayscale_enabled", "type": "int",  "cfg": ["grayscale","enabled"],    "def": false,  "is_bool": true,  "ui_check": "grayscale"},

  // ── pixelate ──
  // cfg key is "block_size" not "amount"
  {"field": "g_pixelate_size",     "type": "float","cfg": ["pixelate","block_size"],  "def": 8.0,    "ui_edit": "pixelate"},
  {"field": "g_pixelate_enabled",  "type": "int",  "cfg": ["pixelate","enabled"],     "def": false,  "is_bool": true,  "ui_check": "pixelate"},

  // ── blend : int in cbuffer, computed from string via map ──
  {"field": "g_blend_enabled",     "type": "int",
   "cfg": ["blend_mode","mode"],
   "map": ["normal","additive","xnor","subtract","multiply","screen","difference","overlay","and","or"],
   "computed_load": true, "combo": "blend"},

  // ── glitch ──
  {"field": "g_glitch_intensity", "type": "float", "cfg": ["glitch","intensity"],     "def": 0.05,   "ui_edit": "glitch"},
  {"field": "g_glitch_enabled",   "type": "int",   "cfg": ["glitch","enabled"],       "def": false,  "is_bool": true,  "ui_check": "glitch"},

  // ── edge detect ──
  {"field": "g_edge_enabled",     "type": "int",   "cfg": ["edge_detect","enabled"],  "def": false,  "is_bool": true,  "ui_check": "edge"},

  // ── chromatic aberration ──
  {"field": "g_chroma_enabled",   "type": "int",   "cfg": ["chromatic_aberration","enabled"],  "def": false,    "is_bool": true,  "ui_check": "chroma"},
  {"field": "g_chroma_amount",    "type": "float", "cfg": ["chromatic_aberration","amount"],   "def": 0.003,    "ui_edit": "chroma"},
  // chroma_mode: int in cbuffer, computed from string → int map
  {"field": "g_chroma_mode",      "type": "int",
   "cfg": ["chromatic_aberration","mode"],
   "map": {"off": 0, "static": 1, "fade": 2},
   "def": "off", "computed_load": true},
  {"field": "g_chroma_fade_speed","type": "float",  "cfg": ["chromatic_aberration","fade_speed"],"def": 1.0},

  // ── sharpness ──
  {"field": "g_sharp_enabled",    "type": "int",   "cfg": ["sharpness","enabled"],    "def": false,  "is_bool": true,  "ui_check": "sharp"},
  {"field": "g_sharp_amount",     "type": "float", "cfg": ["sharpness","amount"],     "def": 1.0,    "ui_edit": "sharp"},

  // ── screen wave ──
  {"field": "g_wave_enabled",        "type": "int",   "cfg": ["screen_wave","enabled"],        "def": false,  "is_bool": true,  "ui_check": "wave"},
  {"field": "g_wave_intensity",      "type": "float", "cfg": ["screen_wave","intensity"],      "def": 0.02,   "ui_edit": "wave"},
  {"field": "g_wave_speed",          "type": "float", "cfg": ["screen_wave","speed"],          "def": 0.5,    "ui_edit": "wave_speed"},
  {"field": "g_wave_distance",       "type": "float", "cfg": ["screen_wave","distance"],       "def": 1.0,    "ui_edit": "wave_dist"},
  {"field": "g_wave_x_enabled",      "type": "int",   "cfg": ["screen_wave","x_enabled"],      "def": true,   "is_bool": true,  "ui_check": "wave_x"},
  {"field": "g_wave_y_enabled",      "type": "int",   "cfg": ["screen_wave","y_enabled"],      "def": true,   "is_bool": true,  "ui_check": "wave_y"},
  {"field": "g_wave_shift_enabled",  "type": "int",   "cfg": ["screen_wave","shift_enabled"],  "def": false,  "is_bool": true,  "ui_check": "wave_shift"},
  {"field": "g_wave_shift_amount",   "type": "float", "cfg": ["screen_wave","shift_amount"],   "def": 0.5,    "ui_edit": "wave_shamt"},
  {"field": "g_wave_shift_speed",    "type": "float", "cfg": ["screen_wave","shift_speed"],    "def": 1.0,    "ui_edit": "wave_shspd"},
  {"field": "g_wave_rotation_enabled","type": "int",  "cfg": ["screen_wave","rotation_enabled"],"def": false,  "is_bool": true,  "ui_check": "wave_rot"},
  {"field": "g_wave_rotation_min",   "type": "float", "cfg": ["screen_wave","rotation_min"],   "def": -180.0, "ui_edit": "wave_rotmin"},
  {"field": "g_wave_rotation_max",   "type": "float", "cfg": ["screen_wave","rotation_max"],   "def": 180.0,  "ui_edit": "wave_rotmax"},

  // ── motion trail ──
  {"field": "g_trail_enabled",    "type": "int",   "cfg": ["motion_trail","enabled"],   "def": false,  "is_bool": true,  "ui_check": "trail"},
  {"field": "g_trail_decay",      "type": "float", "computed_load": true},  // derived from trail_frames in main.cpp
  {"field": "g_trail_opacity",    "type": "float", "cfg": ["motion_trail","opacity"],   "def": 0.5,    "ui_edit": "trail_opacity"},

  // ── warm animated bloom ──
  {"field": "g_glow_enabled",      "type": "int",   "cfg": ["glow","enabled"],       "def": false,  "is_bool": true,  "ui_check": "glow"},
  {"field": "g_glow_intensity",    "type": "float", "cfg": ["glow","intensity"],     "def": 0.3,    "ui_edit": "glow"},
  {"field": "g_glow_speed",        "type": "float", "cfg": ["glow","speed"],         "def": 0.3,    "ui_edit": "glow_speed"},
  {"field": "g_glow_distance",     "type": "float", "cfg": ["glow","distance"],      "def": 0.3,    "ui_edit": "glow_distance"},
  {"field": "g_glow_move_enabled", "type": "int",   "cfg": ["glow","move_enabled"],  "def": true,   "is_bool": true,  "ui_check": "glow_move"},

  // ── hlsl padding ──
  {"field": "g_pad2",             "type": "int"}
]
